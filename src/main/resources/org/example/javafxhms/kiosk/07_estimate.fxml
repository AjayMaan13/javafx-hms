<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- KIOSK STEP 7: Estimate with guest information and booking total. -->
<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@kiosk.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label styleClass="header-title" text="Maple Leaf Hotel - Self Check-in Kiosk" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="header-step" text="Step 6 of 7 - Estimate" />
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18.0">
            <padding>
                <Insets bottom="30.0" left="34.0" right="34.0" top="32.0" />
            </padding>

            <Label styleClass="page-title" text="Review guest and estimate" />
            <Label styleClass="subtitle" text="Confirm the guest information and estimated booking total before continuing." />

            <HBox alignment="TOP_CENTER" spacing="18.0">
                <VBox prefWidth="360.0" spacing="10.0" styleClass="card">
                    <Label styleClass="field-label" text="Guest Information" />
                    <GridPane hgap="16.0" vgap="8.0">
                        <Label styleClass="field-label" text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="guestNameLabel" text="Guest name from details" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="Phone" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="guestPhoneLabel" text="Phone from details" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="Email" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="guestEmailLabel" text="Email from details" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label styleClass="field-label" text="Address" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="guestAddressLabel" text="Address from details" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label styleClass="field-label" text="City / Postal" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="guestCityPostalLabel" text="City / postal from details" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label styleClass="field-label" text="Loyalty" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Label fx:id="guestLoyaltyLabel" styleClass="price-tag" text="Loyalty status from lookup" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </GridPane>
                </VBox>

                <VBox prefWidth="420.0" spacing="10.0" styleClass="card">
                    <Label styleClass="field-label" text="Booking Total" />
                    <GridPane hgap="40.0" vgap="10.0">
                        <Label text="Room (1 x Double, 2 nights)" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label text="\$240.00" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Add-ons (Wi-Fi, Breakfast)" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label text="\$34.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Subtotal" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label text="\$274.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Tax (13%)" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label text="\$35.62" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label styleClass="price-tag" text="Loyalty discount" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label styleClass="price-tag" text="- \$10.00" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </GridPane>

                    <Separator />

                    <HBox>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="bookingTotalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="\$299.62" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="10.0" />
            </padding>
            <Button styleClass="secondary-btn" text="Back" />
            <Button styleClass="primary-btn" text="Confirm Booking" />
        </HBox>
    </bottom>
</BorderPane>
