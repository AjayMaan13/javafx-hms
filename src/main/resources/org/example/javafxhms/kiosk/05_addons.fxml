<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- KIOSK STEP 5: Add-ons. CheckBox per add-on, each showing its price impact. -->
<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@kiosk.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label styleClass="header-title" text="Maple Leaf Hotel — Self Check-in Kiosk" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="header-step" text="Step 4 of 7  ·  Add-ons" />
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <Label styleClass="page-title" text="Enhance your stay" />
            <Label styleClass="subtitle" text="Optional extras — pick any you'd like." />

            <VBox maxWidth="460.0" spacing="14.0" styleClass="card">
                <HBox alignment="CENTER_LEFT">
                    <CheckBox text="Wi-Fi" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="price-tag" text="+ $5.00 / night" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <CheckBox text="Breakfast" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="price-tag" text="+ $12.00 / night" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <CheckBox text="Parking" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="price-tag" text="+ $8.00 / night" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <CheckBox text="Spa access" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="price-tag" text="+ $20.00 / night" />
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="10.0" />
            </padding>
            <Button styleClass="secondary-btn" text="←  Back" />
            <Button styleClass="primary-btn" text="Next  →" />
        </HBox>
    </bottom>
</BorderPane>
