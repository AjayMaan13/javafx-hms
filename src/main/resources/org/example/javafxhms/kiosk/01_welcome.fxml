<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- KIOSK STEP 1: Welcome. BorderPane = top header, left "Rules & Regulations"
     side nav (always visible), center welcome message + Start button. -->

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@kiosk.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Header bar (same on every screen) -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label styleClass="header-title" text="Maple Leaf Hotel — Self Check-in Kiosk" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="header-step" text="Welcome" />
        </HBox>
    </top>

    <!-- Always-visible side nav for rules -->
    <left>
        <VBox prefWidth="220.0" spacing="10.0" styleClass="side-nav">
            <Label styleClass="side-nav-title" text="Rules &amp; Regulations" />
            <Separator />
            <Label text="• Check-in from 3:00 PM" wrapText="true" />
            <Label text="• Valid photo ID required" wrapText="true" />
            <Label text="• No smoking in rooms" wrapText="true" />
            <Label text="• Pay outstanding balance at front desk" wrapText="true" />
        </VBox>
    </left>

    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="24.0">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                </padding>

                <Label styleClass="page-title" text="Welcome! Let's get you checked in." />
                <Label styleClass="subtitle" text="Book a room in a few quick steps — no waiting in line." wrapText="true" />
                <Label text="• Check-out by 11:00 AM" wrapText="true" />

                <!-- Placeholder for the promo video / gif mentioned in the brief -->
                <Region prefHeight="180.0" prefWidth="320.0"
                        style="-fx-background-color: #dfe6ee; -fx-background-radius: 8;" />

                <Label styleClass="subtitle" text="[ promotional video / gif placeholder ]" />

                <Button styleClass="primary-btn" text="Start Booking  →" />

                <!-- New Buttons -->
                <Button styleClass="primary-btn" text="Admin Login" />
                <Button styleClass="primary-btn" text="Leave Feedback" />

            </VBox>
        </StackPane>
    </center>

</BorderPane>