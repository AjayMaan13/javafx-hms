<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- KIOSK LOYALTY SIGN-UP: Compact full-page form that fits the kiosk screen. -->
<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@kiosk.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label styleClass="header-title" text="Maple Leaf Hotel - Self Check-in Kiosk" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="header-step" text="Loyalty Enrollment" />
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="18.0" left="32.0" right="32.0" top="24.0" />
            </padding>

            <Label styleClass="page-title" text="Join Maple Rewards" />
            <Label styleClass="subtitle" text="Create a loyalty profile when your phone number is not already registered." />

            <HBox spacing="16.0">
                <VBox prefWidth="260.0" spacing="8.0" styleClass="card">
                    <Label styleClass="field-label" text="Member Benefits" />
                    <Label styleClass="subtitle" text="Earn points on every paid stay." />
                    <Label styleClass="subtitle" text="Redeem points toward billing." />
                    <Label styleClass="subtitle" text="Get member-only offers." />
                    <Label styleClass="subtitle" text="Use faster future check-in." />
                    <Label styleClass="subtitle" text="Receive birthday promotions." />
                </VBox>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Create Loyalty Account" />
                    <GridPane hgap="12.0" vgap="8.0">
                        <Label styleClass="field-label" text="First name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="loyaltyFirstNameField" prefWidth="180.0" promptText="First name"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="Last name" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="loyaltyLastNameField" prefWidth="180.0" promptText="Last name"
                                   GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="Phone" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="loyaltyPhoneSignupField" prefWidth="180.0" promptText="(555) 123-4567"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="Email" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="loyaltyEmailField" prefWidth="180.0" promptText="you@example.com"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="Address" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="loyaltyStreetAddressField" prefWidth="180.0" promptText="123 Main Street"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label styleClass="field-label" text="Unit / Apt" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <TextField fx:id="loyaltyUnitNumberField" prefWidth="180.0" promptText="Unit"
                                   GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        <Label styleClass="field-label" text="City" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="loyaltyCityField" prefWidth="180.0" promptText="City"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label styleClass="field-label" text="State" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <TextField fx:id="loyaltyStateProvinceField" prefWidth="180.0" promptText="State / Province"
                                   GridPane.columnIndex="3" GridPane.rowIndex="3" />

                        <Label styleClass="field-label" text="Postal code" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="loyaltyPostalCodeField" prefWidth="180.0" promptText="Postal / ZIP"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label styleClass="field-label" text="Country" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                        <TextField fx:id="loyaltyCountryField" prefWidth="180.0" promptText="Country"
                                   GridPane.columnIndex="3" GridPane.rowIndex="4" />
                    </GridPane>

                    <CheckBox fx:id="loyaltyTermsCheck"
                              text="I agree to create a loyalty account and receive member benefits." />
                    <Label styleClass="success-text"
                           text="Profile links to billing for points, redemptions, and loyalty discounts." />
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="32.0" right="32.0" top="10.0" />
            </padding>
            <Button minWidth="170.0" styleClass="secondary-btn" text="Back to Guest Details" />
            <Button minWidth="190.0" styleClass="primary-btn" text="Create Loyalty Account" />
        </HBox>
    </bottom>
</BorderPane>
