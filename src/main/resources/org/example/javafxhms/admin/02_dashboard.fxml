<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ADMIN SCREEN 2: Dashboard. Filters (name/phone/date range/status) +
     paginated, sortable TableView of guests/reservations. -->
<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@admin.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label styleClass="header-title" text="Maple Leaf Hotel — Admin" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="header-step" text="Dashboard" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200.0" spacing="10.0" styleClass="side-nav">
            <Label styleClass="side-nav-title" text="Admin Menu" />
            <Separator />
            <Label styleClass="nav-link" text="Dashboard" />
            <Label styleClass="nav-link" text="Waitlist" />
            <Label styleClass="nav-link" text="Feedback" />
            <Label styleClass="nav-link" text="Reports" />
            <Label styleClass="nav-link" text="Log Out" />
        </VBox>
    </left>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>

            <Label styleClass="page-title" text="Guests &amp; Reservations" />

            <!-- Filter bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Name" />
                    <TextField promptText="Guest name" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Phone" />
                    <TextField promptText="Phone" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="From" />
                    <DatePicker prefWidth="140.0" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="To" />
                    <DatePicker prefWidth="140.0" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Status" />
                    <ComboBox prefWidth="150.0" promptText="Any status" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="primary-btn" text="Search" />
            </HBox>

            <!-- Sortable, paginated table -->
            <TableView fx:id="reservationTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="150.0" text="Guest" />
                    <TableColumn prefWidth="120.0" text="Phone" />
                    <TableColumn prefWidth="100.0" text="Check-in" />
                    <TableColumn prefWidth="100.0" text="Check-out" />
                    <TableColumn prefWidth="110.0" text="Status" />
                    <TableColumn prefWidth="120.0" text="Room(s)" />
                    <TableColumn prefWidth="100.0" text="Balance" />
                </columns>
            </TableView>

            <Pagination maxPageIndicatorCount="5" pageCount="8" />

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button styleClass="secondary-btn" text="View / Edit" />
                <Button styleClass="danger-btn" text="Cancel Reservation" />
                <Button styleClass="primary-btn" text="+ New Reservation" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
