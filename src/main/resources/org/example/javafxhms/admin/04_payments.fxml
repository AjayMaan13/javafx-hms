<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ADMIN SCREEN 4: Payments. Cash/card/loyalty, deposits, partial payments,
     refunds; paid vs outstanding balance. -->
<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@admin.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label styleClass="header-title" text="Maple Leaf Hotel — Admin" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="header-step" text="Payments" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200.0" spacing="10.0" styleClass="side-nav">
            <Label styleClass="side-nav-title" text="Admin Menu" />
            <Separator />
            <Label styleClass="nav-link" text="Dashboard" />
            <Label styleClass="nav-link" text="Waitlist" />
            <Label styleClass="nav-link" text="Feedback" />
            <Label styleClass="nav-link" text="Reports" />
            <Label styleClass="nav-link" text="Log Out" />
        </VBox>
    </left>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>

            <Label styleClass="page-title" text="Payments — Reservation #HMS-2026-00417" />

            <!-- Balance summary -->
            <HBox spacing="40.0" styleClass="card">
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Total Due" />
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="\$299.62" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Total Paid" />
                    <Label styleClass="price-tag" style="-fx-font-size: 18px;" text="\$150.00" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Outstanding Balance" />
                    <Label styleClass="balance-due" style="-fx-font-size: 18px;" text="\$149.62" />
                </VBox>
            </HBox>

            <!-- New payment / refund form -->
            <VBox spacing="10.0" styleClass="card">
                <Label styleClass="field-label" text="Record Payment / Refund" />
                <GridPane hgap="20.0" vgap="10.0">
                    <Label styleClass="field-label" text="Method" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <ComboBox prefWidth="160.0" promptText="Cash / Card / Loyalty"
                              GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="field-label" text="Amount" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField prefWidth="140.0" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                </GridPane>
                <Label styleClass="subtitle" text="Enter a negative amount to record a refund." />
                <HBox spacing="12.0">
                    <Button styleClass="primary-btn" text="Add Payment" />
                    <Button styleClass="secondary-btn" text="Issue Refund" />
                </HBox>
            </VBox>

            <!-- Payment history -->
            <Label styleClass="field-label" text="Payment History" />
            <TableView fx:id="paymentTable" prefHeight="180.0">
                <columns>
                    <TableColumn prefWidth="140.0" text="Date/Time" />
                    <TableColumn prefWidth="120.0" text="Method" />
                    <TableColumn prefWidth="120.0" text="Amount" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
