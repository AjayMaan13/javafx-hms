<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Dashboard content only — header/side-nav now live once in AdminShell.fxml. -->
<VBox spacing="16"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.admin.DashboardController">

    <padding>
        <Insets top="20"
                left="24"
                right="24"
                bottom="20"/>
    </padding>

    <Label styleClass="page-title"
           text="Guests &amp; Reservations"/>

    <HBox spacing="12"
          alignment="CENTER_LEFT"
          styleClass="card">

        <VBox spacing="2">
            <Label text="Name"/>
            <TextField fx:id="nameFilterField" promptText="Guest name"/>
        </VBox>

        <VBox spacing="2">
            <Label text="Phone"/>
            <TextField fx:id="phoneFilterField" promptText="Phone"/>
        </VBox>

        <VBox spacing="2">
            <Label text="From"/>
            <DatePicker fx:id="fromDatePicker"/>
        </VBox>

        <VBox spacing="2">
            <Label text="To"/>
            <DatePicker fx:id="toDatePicker"/>
        </VBox>

        <VBox spacing="2">
            <Label text="Status"/>
            <ComboBox fx:id="statusFilterCombo" promptText="Any Status"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="searchButton" text="Search" onAction="#handleSearch"/>
        <Button text="Clear" styleClass="secondary-btn" onAction="#handleClearFilters"/>

    </HBox>

    <Label styleClass="subtitle" text="Double-click a row to open its Reservation Detail." />

    <TableView fx:id="reservationTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn text="Guest"
                         prefWidth="150"/>

            <TableColumn text="Phone"
                         prefWidth="120"/>

            <TableColumn text="Check In"
                         prefWidth="100"/>

            <TableColumn text="Check Out"
                         prefWidth="100"/>

            <TableColumn text="Status"
                         prefWidth="120"/>

            <TableColumn text="Rooms"
                         prefWidth="120"/>

            <TableColumn text="Balance"
                         prefWidth="100"/>

        </columns>

    </TableView>

    <Pagination pageCount="1"/>

</VBox>
