<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ADMIN SCREEN 8 content only: Reports. Header/side-nav live once in AdminShell.fxml.
     Revenue / occupancy / activity-log tables (no charts, per brief), each row real,
     each exportable to CSV/PDF/TXT. Table columns rebuild per report type in the
     controller, since each report has genuinely different columns. -->
<VBox spacing="16.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel.controller.admin.ReportsController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <Label styleClass="page-title" text="Reports" />

    <!-- Report selector -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
        <VBox spacing="2.0">
            <Label styleClass="field-label" text="Report type" />
            <ComboBox fx:id="reportTypeComboBox" prefWidth="200.0" promptText="Revenue / Occupancy / Activity Log" />
        </VBox>
        <VBox spacing="2.0">
            <Label styleClass="field-label" text="From" />
            <DatePicker fx:id="fromDatePicker" prefWidth="140.0" />
        </VBox>
        <VBox spacing="2.0">
            <Label styleClass="field-label" text="To" />
            <DatePicker fx:id="toDatePicker" prefWidth="140.0" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button styleClass="primary-btn" text="Generate" onAction="#generateReport" />
    </HBox>

    <!-- Tabular report output (no charts, per brief) — columns rebuilt per report type -->
    <TableView fx:id="reportTable" prefHeight="300.0" VBox.vgrow="ALWAYS" />

    <Label fx:id="messageLabel" styleClass="error-text" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button styleClass="secondary-btn" text="Export CSV" onAction="#exportCsv" />
        <Button styleClass="secondary-btn" text="Export PDF" onAction="#exportPdf" />
        <Button styleClass="secondary-btn" text="Export TXT" onAction="#exportTxt" />
    </HBox>
</VBox>
