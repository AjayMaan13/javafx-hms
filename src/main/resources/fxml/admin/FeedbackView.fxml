<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ADMIN SCREEN 7 content only: Feedback view. Header/side-nav live once in
     AdminShell.fxml. Real data from FeedbackRepository; only guests who have checked out
     and settled their balance can submit (enforced by FeedbackService, kiosk side). -->
<VBox spacing="16.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel.controller.admin.FeedbackViewController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <Label styleClass="page-title" text="Guest Feedback" />
    <Label styleClass="subtitle" text="Only shows feedback submitted after checkout and full settlement." />

    <!-- Filter controls -->
    <VBox spacing="14.0" styleClass="card">
        <GridPane hgap="18.0" vgap="10.0">
            <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Guest" />
                <TextField fx:id="guestFilterField" prefWidth="180.0" promptText="Guest name" />
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Rating" />
                <ComboBox fx:id="ratingComboBox" prefWidth="120.0" promptText="Any" />
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Sentiment" />
                <ComboBox fx:id="sentimentComboBox" prefWidth="170.0" promptText="Positive / Negative" />
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Date" />
                <DatePicker fx:id="datePicker" prefWidth="150.0" />
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Label fx:id="averageRatingLabel" styleClass="price-tag" />
            <Region HBox.hgrow="ALWAYS" />
            <Button minWidth="120.0" styleClass="primary-btn" text="Filter" onAction="#viewFeedback" />
            <Button minWidth="120.0" styleClass="secondary-btn" text="Clear" onAction="#clearFilters" />
            <Button fx:id="exportFeedbackPdfButton" minWidth="150.0" styleClass="secondary-btn" text="Export" onAction="#exportFeedback" />
        </HBox>
    </VBox>

    <TableView fx:id="feedbackTable" prefHeight="320.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="guestColumn" prefWidth="160.0" text="Guest" />
            <TableColumn fx:id="ratingColumn" prefWidth="70.0" text="Rating" />
            <TableColumn fx:id="sentimentColumn" prefWidth="90.0" text="Sentiment" />
            <TableColumn fx:id="commentColumn" prefWidth="290.0" text="Comment" />
            <TableColumn fx:id="dateColumn" prefWidth="110.0" text="Date" />
        </columns>
    </TableView>

    <Label fx:id="messageLabel" styleClass="error-text" wrapText="true" />
</VBox>
