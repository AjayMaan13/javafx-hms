<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.hotel.controller.kiosk.RoomSelectionController"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="24.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <Label styleClass="page-title" text="Choose your room" />
            <Label styleClass="subtitle" wrapText="true"
                   text="Please review the room booking policy in Rules &amp; Regulations before choosing." />

            <VBox spacing="12.0" styleClass="card">
                <GridPane hgap="18.0" vgap="12.0">
                    <Label styleClass="field-label" text="Room Type" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label styleClass="field-label" text="Sleeps" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label styleClass="field-label" text="Price / Night" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <Label styleClass="field-label" text="Quantity" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <Label text="Single Room" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="singleCapacityLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label fx:id="singlePriceLabel" styleClass="price-tag" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <Spinner fx:id="singleQty" editable="true" prefWidth="90.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <Label text="Double Room" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="doubleCapacityLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label fx:id="doublePriceLabel" styleClass="price-tag" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    <Spinner fx:id="doubleQty" editable="true" prefWidth="90.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                    <Label text="Deluxe Room" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="deluxeCapacityLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <Label fx:id="deluxePriceLabel" styleClass="price-tag" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                    <Spinner fx:id="deluxeQty" editable="true" prefWidth="90.0" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                    <Label text="Penthouse" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="penthouseCapacityLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    <Label fx:id="penthousePriceLabel" styleClass="price-tag" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                    <Spinner fx:id="penthouseQty" editable="true" prefWidth="90.0" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                </GridPane>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="10.0" />
            </padding>
            <Button onAction="#handleBack" styleClass="secondary-btn" text="←  Back" />
            <Button onAction="#handleNext" styleClass="primary-btn" text="Next  →" />
        </HBox>
    </bottom>
</BorderPane>
