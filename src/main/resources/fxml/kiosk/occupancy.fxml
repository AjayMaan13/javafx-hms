<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.hotel.controller.kiosk.OccupancyController"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <Label styleClass="page-title" text="How many guests?" />
            <Label styleClass="subtitle" text="Tell us how many people will be staying." />

            <VBox maxWidth="420.0" spacing="18.0" styleClass="card">
                <GridPane hgap="20.0" vgap="18.0">
                    <Label styleClass="field-label" text="Adults" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Spinner fx:id="adultsSpinner" editable="true" prefWidth="120.0"
                             GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="field-label" text="Children" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Spinner fx:id="childrenSpinner" editable="true" prefWidth="120.0"
                             GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </GridPane>
                <Label styleClass="subtitle" text="At least 1 adult is required per booking." />
                <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" />
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="10.0" />
            </padding>
            <Button onAction="#handleBack" styleClass="secondary-btn" text="←  Back" />
            <Button onAction="#handleNext" styleClass="primary-btn" text="Next  →" />
        </HBox>
    </bottom>
</BorderPane>
