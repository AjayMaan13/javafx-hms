<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.hotel.controller.kiosk.GuestDetailsController"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <Label styleClass="page-title" text="Guest details" />
            <Label styleClass="subtitle" wrapText="true" text="Fields marked * are required." />

            <VBox maxWidth="520.0" spacing="14.0" styleClass="card">
                <GridPane hgap="14.0" vgap="12.0">
                    <HBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label styleClass="field-label" text="First name " />
                        <Label styleClass="required" text="*" />
                    </HBox>
                    <TextField fx:id="firstNameField" prefWidth="210.0" promptText="First name"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <HBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label styleClass="field-label" text="Last name " />
                        <Label styleClass="required" text="*" />
                    </HBox>
                    <TextField fx:id="lastNameField" prefWidth="210.0" promptText="Last name"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <HBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label styleClass="field-label" text="Phone " />
                        <Label styleClass="required" text="*" />
                    </HBox>
                    <TextField fx:id="phoneField" prefWidth="210.0" promptText="(555) 123-4567"
                               GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <HBox GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label styleClass="field-label" text="Email " />
                        <Label styleClass="required" text="*" />
                    </HBox>
                    <TextField fx:id="emailField" prefWidth="210.0" promptText="you@example.com"
                               GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label styleClass="field-label" text="Address" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="addressField" prefWidth="210.0" promptText="Street address"
                               GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label styleClass="field-label" text="Postal code" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <TextField fx:id="postalCodeField" prefWidth="210.0" promptText="Postal / ZIP code"
                               GridPane.columnIndex="1" GridPane.rowIndex="5" />
                </GridPane>

                <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" />
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="10.0" />
            </padding>
            <Button onAction="#handleBack" styleClass="secondary-btn" text="←  Back" />
            <Button onAction="#handleNext" styleClass="primary-btn" text="Next  →" />
        </HBox>
    </bottom>
</BorderPane>
